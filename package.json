{
  "name": "luke-jarvis",
  "version": "0.11.2",
  "description": "贾维斯数字员工公司（领域无关的操作系统）：需求分级 → CEO 定领域流程 → 现场蒸馏角色卡(六段式+证据链+防冒名) → 项目沉淀(.jarvis/ 可复用) → 协同/会议/黑板/问题上行/能力补足。插件不携带任何静态角色卡与领域模板——卡与流程沉淀在项目里。含可执行 /jarvis 命令。",
  "type": "module",
  "main": "src/host/plugin.js",
  "exports": {
    ".": "./src/host/plugin.js",
    "./host": "./src/host/plugin.js",
    "./cli": "./bin/luke-jarvis.mjs",
    "./preset/*": "./preset/*",
    "./presets/*": "./presets/*",
    "./skills/*": "./skills/*",
    "./office/*": "./office/*",
    "./package.json": "./package.json",
    "./core": "./src/host/core/index.js",
    "./adapters/*": "./src/host/adapters/*",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "BSD-3-Clause",
  "files": [
    "src",
    "bin",
    "presets",
    "preset",
    "skills",
    "docs",
    "test",
    "scripts",
    "cordis.patch.yml",
    "office",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "locale",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "agent",
    "preset",
    "agent-teams",
    "digital-employee",
    "jarvis",
    "luke-jarvis",
    "distill",
    "role-card"
  ],
  "scripts": {
    "test": "node --test test/plugin.test.js test/core.test.js",
    "typecheck:manual": "node --check src/host/plugin.js",
    "selfcheck": "bash scripts/selfcheck.sh",
    "setup": "node bin/luke-jarvis.mjs setup",
    "doctor": "node bin/luke-jarvis.mjs doctor",
    "build:presets": "node scripts/build-preset-patches.mjs",
    "check:presets": "node scripts/build-preset-patches.mjs --check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ljjluke/luke-jarvis.git"
  },
  "dependencies": {
    "@nanmicoder/dsh-agent-teams": "^0.1.28"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "bin": {
    "luke-jarvis": "./bin/luke-jarvis.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
