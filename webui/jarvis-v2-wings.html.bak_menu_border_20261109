document.getElementById('teamChatForm').addEventListener('submit',e=>{e.preventDefault();const text=teamChatInput.value.trim();if(!text)return;addTeamMessage('你',text);teamChatInput.value='';if(voiceEnabled)speak('消息已发送到协作会话。',true)});
document.querySelectorAll('[data-decision]').forEach(button=>button.addEventListener('click',()=>{const approved=button.dataset.decision==='approve';const result=approved?'已批准将新路由策略应用到全部通道。我会继续观察回归结果。':'已保留为测试策略，不会扩大到其他通道。';const bar=document.getElementById('decisionBar');bar.querySelector('.decision-copy b').textContent=approved?'决定已记录：应用到全部通道':'决定已记录：仅保留测试';bar.querySelector('.decision-copy span').textContent=result;bar.querySelector('.decision-actions').textContent=approved?'已批准':'已保留测试';addTeamMessage('Jarvis',result);if(voiceEnabled)speak(result,true)}));
const root=document.documentElement;addEventListener('pointermove',e=>{if(matchMedia('(pointer:fine)').matches){root.style.setProperty('--mx',`${(e.clientX/innerWidth-.5)*18}px`);root.style.setProperty('--my',`${(e.clientY/innerHeight-.5)*12}px`);root.style.setProperty('--ry',`${(e.clientX/innerWidth-.5)*14}deg`);root.style.setProperty('--rx',`${(.5-e.clientY/innerHeight)*10}deg`)}},{passive:true});
