<script>
/* ══ JARVIS 数据接线层（契约 = luke-jarvis 插件 /api/jarvis/*，jarvis.snapshot/1）══
   左右任务条款全部来自 jarvis 拆分的任务点（.agent-teams/<team>/team.json → snapshot.tasks.byAssignee）。
   快照 5s 轮询、事件 3s 增量；连不上后端（file:// 直开或未启动 server.mjs）时保留内置演示内容，零回归。
   本地联调：node server.mjs [--workspace <真实项目路径>]，然后访问 http://127.0.0.1:3080/ */
(function(){
const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>[...r.querySelectorAll(s)];
const esc=s=>String(s??'').replace(/[<>&]/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;'}[c]));
const clip=(s,n)=>{const t=String(s??'').trim();return t.length>n?t.slice(0,n)+'…':t};
const setText=(sel,text,root=document)=>{const el=$(sel,root);if(el)el.textContent=text};
const STATUS_LABEL={in_progress:'进行中',claimed:'已认领',pending:'待开工',completed:'已完成',failed:'失败',cancelled:'已取消',dropped:'已放弃'};
const LIVE={snap:null,events:[],lastSeq:0,connected:false,demo:true};

function eventLine(e){
  const d=e.data||{};
  if(e.type==='gate')return `通过「${d.step}」流程闸`;
  if(e.type==='board')return `黑板更新 · 未决 ${d.open??'?'} 项`;
  if(e.type==='meeting')return `会议${d.type||''} · ${clip(d.topic||'',30)}`;
  if(e.type==='dispatch')return `派活给 ${d.assignee||'成员'}：${clip(d.subject,26)}`;
  if(e.type==='command')return `能力台执行 ${d.tool||''} · ${d.ok?'成功':'失败'}`;
  return e.type||'事件';
}
function eventTime(e){try{return new Date(e.at).toLocaleTimeString('zh-CN',{hour12:false})}catch{return ''}}

/* 主界面：动态卡片系统 —— 卡片由会话快照按价值优先级派生，点击进入动态详情子页 */
const CARD_SLOTS=['.node-left-1','.node-left-3','.report-node','.node-right-2','.node-right-3'];
function cardDecision(snap){
  const need=(snap.board&&snap.board.needsUser)||[];
  const meeting=((snap.meetings&&sneak_meetings(snap))||[])[0];
  if(!need.length&&!meeting)return null;
  const rows=need.slice(0,12).map(n=>({main:clip(n.content,64),sub:n.from?('来自 '+(n.from||'jarvis')):''}));
  if(meeting)rows.push({main:'必开会议 · '+(meeting.type||''),sub:clip(meeting.why||meeting.topic||'',56)});
  return {k:'WAITING YOU · 待你决定',st:'REPLY',title:need.length?clip(need[0].content,22):'必开会议：'+(meeting.type||''),
    copy:need.length?'黑板上有条目需要你答复，Jarvis 正在等待你的决定。':clip(meeting.why||meeting.topic||'',56),
    detail:{kicker:'BOARD · 黑板与会议',title:'需要你决定的事项',copy:'以下是当前需要你亲自决定的内容，其余任务 Jarvis 会继续推进。',
      rows:rows,empty:'暂无待决定事项。'}}
}
function sneak_meetings(snap){return (snap.meetings&&snap.meetings.required)||[]}
function cardMission(snap){
  const tasks=(snap.tasks&&snap.tasks.byAssignee)||[];
  const stage=snap.stage||{index:0,total:6,label:'未开始'};
  const doing=tasks.filter(t=>!['completed','cancelled','dropped'].includes(t.status));
  const done=tasks.filter(t=>t.status==='completed');
  const cur=doing.find(t=>t.status==='in_progress')||doing[0];
  if(!cur)return null;
  const pct=tasks.length?Math.round(done.length/tasks.length*100):0;
  return {k:'ACTIVE MISSION · 当前任务',st:'RUNNING',title:cur.subject,
    copy:`${cur.assignee||'未分配'} · ${STATUS_LABEL[cur.status]||cur.status} · 阶段 ${stage.index}/${stage.total} ${stage.label}`,
    data:pct+'%',dataLabel:`已完成 ${done.length} / ${tasks.length} 项`,pct,
    detail:{kicker:'MISSION · 当前任务',title:cur.subject,
      copy:`负责人 ${cur.assignee||'未分配'} · 状态 ${STATUS_LABEL[cur.status]||cur.status}${cur.attempt>1?` · 第 ${cur.attempt} 次尝试`:''}${cur.dependencies&&cur.dependencies.length?` · 依赖 ${cur.dependencies.join('/')}`:''}`,
      meta:[['整体完成',pct+'%'],['进行中',String(doing.length)],['已完成',String(done.length)],['阶段',`${stage.index}/${stage.total} ${stage.label}`]],
      rows:doing.slice(0,15).map(t=>({main:clip(t.subject,48),sub:`${t.assignee||'未分配'} · ${STATUS_LABEL[t.status]||t.status}`}))}}
}
function cardGap(snap){
  const stage=snap.stage||{};
  if(!(stage.missing&&stage.missing.length))return null;
  return {k:'STAGE GAP · 阶段缺口',st:String(stage.missing.length)+' OPEN',title:`${stage.label||'当前'}阶段缺口`,
    copy:stage.missing.join('；'),
    detail:{kicker:'STAGE · 阶段推进',title:`${stage.label||'当前'}阶段缺口`,
      copy:stage.next?('补齐缺口后：'+stage.next):'补齐以下缺口后，Jarvis 会自动推进到下一阶段。',
      rows:stage.missing.map(m=>({main:clip(m,60)})),empty:'暂无缺口。'}}
}
function cardQueue(snap){
  const tasks=(snap.tasks&&snap.tasks.byAssignee)||[];
  const doing=tasks.filter(t=>!['completed','cancelled','dropped'].includes(t.status));
  const queued=doing.filter(t=>t.status!=='in_progress');
  if(!queued.length)return null;
  return {k:'TASK QUEUE · 任务队列',st:queued.length+' PENDING',title:queued[0].subject,
    copy:`${queued[0].assignee||'未分配'} · ${STATUS_LABEL[queued[0].status]||queued[0].status}${queued.length>1?` 等 ${queued.length} 项排队`:''}`,
    detail:{kicker:'QUEUE · 任务队列',title:`排队中的任务（${queued.length}）`,
      copy:'以下任务已拆分、尚未开工，按拆分顺序执行。',
      rows:queued.slice(0,15).map(t=>({main:clip(t.subject,48),sub:`${t.assignee||'未分配'} · ${STATUS_LABEL[t.status]||t.status}${t.dependencies&&t.dependencies.length?` · 依赖 ${t.dependencies.join('/')}`:''}`}))}}
}
function cardReport(snap){
  const tasks=(snap.tasks&&snap.tasks.byAssignee)||[];
  const done=tasks.filter(t=>t.status==='completed');
  const last=done[done.length-1];
  if(!last)return null;
  return {k:'LATEST REPORT · 完成汇报',st:'DONE',title:last.subject,
    copy:`${last.assignee||'成员'} 已交付${last.attempt>1?` · 第 ${last.attempt} 次尝试通过`:''} · 等待验收`,
    detail:{kicker:'REPORT · 完成汇报',title:'已完成任务',
      copy:'以下任务点已交付，等待验收或已通过。',
      rows:done.slice(-15).reverse().map(t=>({main:clip(t.subject,48),sub:`${t.assignee||'成员'} · 已完成${t.attempt>1?` · 第 ${t.attempt} 次`:''}`}))}}
}
function cardTeam(snap){
  const tasks=(snap.tasks&&snap.tasks.byAssignee)||[];
  const byPerson={};
  for(const t of tasks)(byPerson[t.assignee||'未分配']=byPerson[t.assignee||'未分配']||[]).push(t);
  const names=Object.keys(byPerson);
  if(names.length<2)return null;
  const busy=names.filter(n=>byPerson[n].some(t=>t.status==='in_progress')).length;
  return {k:'TEAM CHANNEL · 团队通道',st:names.length+' MEMBERS',title:'团队任务分布',
    copy:`按负责人聚合 · 共 ${tasks.length} 项拆分任务 · ${busy} 人执行中`,
    detail:{kicker:'TEAM · 团队通道',title:'按负责人的任务分布',
      rows:names.map(n=>{const arr=byPerson[n];const d=arr.filter(t=>t.status==='completed').length;const run=arr.some(t=>t.status==='in_progress');const bad=arr.some(t=>t.status==='failed');
        return {main:`${n} · ${arr.length} 项（完成 ${d}）`,sub:bad?'存在失败任务，需要关注':run?'正在执行':'等待/已交付'}}) ,empty:'尚未建队。'}}
}
function cardEvents(){
  if(!LIVE.events.length)return null;
  return {k:'LIVE EVENTS · 最新动态',st:'LIVE',title:eventLine(LIVE.events[LIVE.events.length-1]),
    copy:'事件流实时更新：派活、过闸、会议与执行反馈。',
    detail:{kicker:'EVENTS · 事件流',title:'最近事件',
      rows:LIVE.events.slice(-15).reverse().map(e=>({main:eventLine(e),sub:eventTime(e)}))}}
}
/* 动态页面：Jarvis 把 HTML 写到 <工作区>/.jarvis/pages/<id>.html，服务端闲置 24h 回收，GC 48h 兜底 */
LIVE.pages=[];
async function loadPages(){
  try{
    const r=await fetch(apiUrl('/api/luke-jarvis/pages'),{cache:'no-store'});
    const b=await r.json();
    const changed=JSON.stringify((b&&b.pages)||[])!==JSON.stringify(LIVE.pages);
    LIVE.pages=(b&&b.pages)||[];
    if(changed&&LIVE.snap)renderMain(LIVE.snap);
  }catch{/* 动态页面失败不影响主状态 */}
}
function cardPages(){
  if(!LIVE.pages.length)return null;
  const latest=LIVE.pages[0];
  const ago=Math.max(1,Math.round((Date.now()-(latest.created||Date.now()))/60000));
