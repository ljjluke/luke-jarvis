micToggle.addEventListener('click',toggleMic);voiceNode.addEventListener('click',toggleMic);voiceNode.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();toggleMic()}});document.getElementById('micMenuToggle').addEventListener('click',()=>{document.querySelector('.jarvis-menu')?.removeAttribute('open');toggleMic()});clearMicWave();addEventListener('pagehide',()=>{stopMic(false);document.body.classList.remove('jarvis-speaking');if('speechSynthesis'in window)speechSynthesis.cancel()});
// 员工协作：本地消息与审批反馈。
const teamChatLog=document.getElementById('teamChatLog'),teamChatInput=document.getElementById('teamChatInput');
