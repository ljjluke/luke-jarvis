    metrics.innerHTML=[['任务完成',`${done.length} / ${tasks.length}`],['未决项',board.open.length],['阻塞',board.blockers.length],['最近交付',last?clip(last.subject,10):'—']].map(([k,v])=>`<div class="report-metric"><span>${k}</span><b>${esc(v)}</b></div>`).join('');
  }
  setText('.report-say',last_report_text(snap));
}
function last_report_text(snap){
