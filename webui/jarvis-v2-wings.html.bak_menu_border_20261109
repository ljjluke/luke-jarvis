function selectJarvisVoice(){if(!('speechSynthesis'in window))return null;const voices=speechSynthesis.getVoices();for(const name of preferredNames){const match=voices.find(v=>v.name.includes(name)&&/zh|Chinese|中文/i.test(`${v.lang} ${v.name}`));if(match){preferredVoice=match;break}}if(!preferredVoice)preferredVoice=voices.find(v=>/zh-CN/i.test(v.lang)&&/xiaoxiao|xiaoyi|xiaohan|xiaomeng|huihui|yaoyao|female|女/i.test(v.name))||voices.find(v=>/zh-CN/i.test(v.lang))||null;voiceEngineLabel.textContent=preferredVoice?`播报声音：${preferredVoice.name} · 语速 0.90 / 音调 0.86`:'将使用系统中文语音 · 成熟女声参数';return preferredVoice}
function updateSpeakerUI(){speakerToggle.classList.toggle('active',voiceEnabled);speakerToggle.querySelector('span').textContent=voiceEnabled?'女声已开启':'启用女声';speakerToggle.setAttribute('aria-pressed',String(voiceEnabled))}
let speakQueue=[],speakingNow=false,lastSpokenText='';
function splitSentences(t){return String(t||'').replace(/\s+/g,' ').split(/(?<=[。！？!?；;])/).map(s=>s.trim()).filter(Boolean)}
function speakServer(s){return fetch('/api/jarvis/tts',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({text:s})}).then(async r=>{if(!r.ok)return false;const blob=await r.blob();const url=URL.createObjectURL(blob);const audio=new Audio(url);await new Promise(res=>{audio.onended=res;audio.onerror=res;audio.play().catch(res)});URL.revokeObjectURL(url);return true}).catch(()=>false)}
function speakBrowser(s){return new Promise(resolve=>{if(!('speechSynthesis'in window))return resolve();const u=new SpeechSynthesisUtterance(s);u.lang='zh-CN';u.rate=.9;u.pitch=.86;u.volume=1;if(preferredVoice)u.voice=preferredVoice;u.onend=()=>resolve();u.onerror=()=>resolve();speechSynthesis.speak(u)})}
async function speakNext(){if(!speakQueue.length){speakingNow=false;document.body.classList.remove('jarvis-speaking');return}const s=speakQueue.shift();const cap=document.getElementById('captionText');if(cap)cap.textContent=s+' ';document.body.classList.add('jarvis-speaking');const used=await speakServer(s);if(!used)await speakBrowser(s);document.body.classList.remove('jarvis-speaking');if(speakQueue.length)setTimeout(speakNext,160)}
function speak(text,force=false){if(!voiceEnabled&&!force)return;const clean=String(text||'').replace(/\s+/g,' ').trim();if(!clean)return;if(clean===lastSpokenText&&!force)return;lastSpokenText=clean;if('speechSynthesis'in window)speechSynthesis.cancel();speakQueue=splitSentences(clean).slice(0,8);if(!speakQueue.length)return;speakingNow=true;speakNext()}
speakerToggle.addEventListener('click',()=>{voiceEnabled=!voiceEnabled;updateSpeakerUI();if(voiceEnabled){selectJarvisVoice();speak(currentView==='main'?mainSpeech:currentView==='team'?teamSpeech:progressSpeech,true)}else{if('speechSynthesis'in window)speechSynthesis.cancel();voiceEngineLabel.textContent='Jarvis 语音播报已静音'}});
if('speechSynthesis'in window){selectJarvisVoice();speechSynthesis.addEventListener?.('voiceschanged',selectJarvisVoice)}
// 麦克风、实时声纹与中文语音指令。
let micStream=null,audioContext=null,analyser=null,micData=null,micRaf=0,recognition=null,micActive=false;
const micToggle=document.getElementById('micToggle'),voiceNode=document.getElementById('voiceNode'),micState=document.getElementById('micState'),voiceNodeTitle=document.getElementById('voiceNodeTitle'),voiceStatus=document.getElementById('voiceStatus'),voiceTranscript=document.getElementById('voiceTranscript'),micCanvas=document.getElementById('micWaveform'),micCtx=micCanvas.getContext('2d');
function setMicUI(state,detail){const labels={offline:'OFFLINE',waiting:'AUTH',live:'LISTENING',error:'ERROR'};micState.textContent=labels[state]||state.toUpperCase();micState.style.color=state==='live'?'var(--green)':state==='error'?'var(--red)':'';micToggle.classList.toggle('mic-live',state==='live');micToggle.querySelector('span').textContent=state==='live'?'断开麦克风':state==='waiting'?'等待授权…':'连接麦克风';voiceNodeTitle.textContent=state==='live'?'我在听，先生。':state==='waiting'?'等待麦克风授权':state==='error'?'麦克风连接失败':'点击连接麦克风';if(detail)voiceStatus.textContent=detail}
function drawMicWave(){if(!analyser)return;analyser.getByteTimeDomainData(micData);const w=micCanvas.width,h=micCanvas.height;micCtx.clearRect(0,0,w,h);micCtx.strokeStyle='rgba(112,234,255,.09)';micCtx.beginPath();micCtx.moveTo(0,h/2);micCtx.lineTo(w,h/2);micCtx.stroke();micCtx.beginPath();for(let i=0;i<micData.length;i++){const x=i/(micData.length-1)*w,y=(micData[i]/255)*h;if(i===0)micCtx.moveTo(x,y);else micCtx.lineTo(x,y)}micCtx.strokeStyle='#70eaff';micCtx.lineWidth=1.5;micCtx.shadowColor='#70eaff';micCtx.shadowBlur=7;micCtx.stroke();micCtx.shadowBlur=0;micRaf=requestAnimationFrame(drawMicWave)}
function clearMicWave(){cancelAnimationFrame(micRaf);micCtx.clearRect(0,0,micCanvas.width,micCanvas.height);micCtx.strokeStyle='rgba(112,234,255,.18)';micCtx.beginPath();micCtx.moveTo(0,19);micCtx.lineTo(micCanvas.width,19);micCtx.stroke()}
function handleVoiceCommand(text){const command=text.replace(/[，。！？\s]/g,'');voiceTranscript.textContent=`你：${text}`;if(/查看进度|任务进度|执行进度/.test(command)){showProgress();return}if(/完成汇报|汇报结果|查看报告/.test(command)){showProgress(true);return}if(/员工|协作空间|团队空间/.test(command)){showTeam();return}if(/返回总览|回到主屏|返回主页面/.test(command)){showMain();return}if(/停止播报|静音|关闭声音/.test(command)){voiceEnabled=false;updateSpeakerUI();speechSynthesis.cancel();voiceEngineLabel.textContent='已通过语音指令静音';return}if(/开启声音|开始播报|恢复播报/.test(command)){voiceEnabled=true;updateSpeakerUI();speak(mainSpeech,true);return}voiceStatus.textContent='已收到语音。可尝试“查看进度”“打开员工空间”或“返回总览”。'}
function startRecognition(){const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){voiceTranscript.textContent='麦克风已连接，但当前浏览器不支持中文语音识别';return}recognition=new SR();recognition.lang='zh-CN';recognition.continuous=true;recognition.interimResults=true;recognition.onresult=e=>{let interim='',final='';for(let i=e.resultIndex;i<e.results.length;i++){const text=e.results[i][0].transcript;if(e.results[i].isFinal)final+=text;else interim+=text}if(interim)voiceTranscript.textContent=`正在聆听：${interim}`;if(final)handleVoiceCommand(final)};recognition.onerror=e=>{if(!['no-speech','aborted'].includes(e.error))voiceTranscript.textContent=`语音识别提示：${e.error}`};recognition.onend=()=>{if(micActive&&recognition)setTimeout(()=>{try{recognition.start()}catch{}},350)};try{recognition.start()}catch{}}
async function startMic(){if(!navigator.mediaDevices?.getUserMedia){setMicUI('error','当前浏览器不支持麦克风，请使用新版 Edge 或 Chrome。');return}setMicUI('waiting','请在浏览器提示中允许使用麦克风。');try{micStream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true}});audioContext=new(window.AudioContext||window.webkitAudioContext)();const source=audioContext.createMediaStreamSource(micStream);analyser=audioContext.createAnalyser();analyser.fftSize=256;analyser.smoothingTimeConstant=.82;source.connect(analyser);micData=new Uint8Array(analyser.fftSize);micActive=true;setMicUI('live','麦克风已连接。直接说出指令，我会用语音回应。');voiceTranscript.textContent='等待你的中文语音指令…';drawMicWave();startRecognition();if(!voiceEnabled){voiceEnabled=true;updateSpeakerUI();selectJarvisVoice()}speak('麦克风已连接。我在听，先生。',true)}catch(error){micActive=false;setMicUI('error',error?.name==='NotAllowedError'?'麦克风权限被拒绝。请在浏览器地址栏中重新允许。':'未检测到可用麦克风，请检查设备连接。');voiceTranscript.textContent='你可以继续使用文字点击操作';clearMicWave()}}
function stopMic(announce=true){micActive=false;if(recognition){const r=recognition;recognition=null;try{r.stop()}catch{}}if(micStream){micStream.getTracks().forEach(track=>track.stop());micStream=null}if(audioContext){audioContext.close().catch(()=>{});audioContext=null}analyser=null;clearMicWave();setMicUI('offline','麦克风已断开，音频不会继续采集。');voiceTranscript.textContent='点击可重新连接麦克风';if(announce&&voiceEnabled)speak('麦克风已断开。',true)}
