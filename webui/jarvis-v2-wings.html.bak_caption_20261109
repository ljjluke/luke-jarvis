<script>
/* ══ JARVIS 数据接线层（契约 = luke-jarvis 插件 /api/jarvis/*，jarvis.snapshot/1）══
   左右任务条款全部来自 jarvis 拆分的任务点（.agent-teams/<team>/team.json → snapshot.tasks.byAssignee）。
   快照 5s 轮询、事件 3s 增量；连不上后端（file:// 直开或未启动 server.mjs）时保留内置演示内容，零回归。
   本地联调：node server.mjs [--workspace <真实项目路径>]，然后访问 http://127.0.0.1:3080/ */
(function(){
const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>[...r.querySelectorAll(s)];
const esc=s=>String(s??'').replace(/[<>&]/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;'}[c]));
const clip=(s,n)=>{const t=String(s??'').trim();return t.length>n?t.slice(0,n)+'…':t};
const setText=(sel,text,root=document)=>{const el=$(sel,root);if(el)el.textContent=text};
const STATUS_LABEL=k=>({in_progress:t('st.in_progress'),claimed:t('st.claimed'),pending:t('st.pending'),completed:t('st.completed'),failed:t('st.failed'),cancelled:t('st.cancelled'),dropped:t('st.dropped')})[k]||k;
const LIVE={snap:null,events:[],lastSeq:0,connected:false,demo:true};

function eventLine(e){
  const d=e.data||{};
  if(e.type==='gate')return t('ev.gate').replace('{s}',d.step||'');
  if(e.type==='board')return t('ev.board').replace('{k}',String(d.open??'?'));
  if(e.type==='meeting')return t('ev.meeting').replace('{ty}',d.type||'').replace('{tp}',clip(d.topic||'',30));
  if(e.type==='dispatch')return t('ev.dispatch').replace('{a}',d.assignee||t('st.member')).replace('{s}',clip(d.subject,26));
  if(e.type==='command')return t('ev.command').replace('{tool}',humanize(d.tool||'')).replace('{r}',d.ok?t('ev.ok'):t('ev.fail'));
  return e.type||t('ev.fallback');
}
function eventTime(e){try{return new Date(e.at).toLocaleTimeString(window.JARVIS_LANG==='en'?'en-US':'zh-CN',{hour12:false})}catch{return ''}}

/* 主界面：动态卡片系统 —— 卡片由会话快照按价值优先级派生，点击进入动态详情子页 */
const CARD_SLOTS=['.node-left-1','.node-left-3','.report-node','.node-right-2','.node-right-3'];
function cardDecision(snap){
  const need=(snap.board&&snap.board.needsUser)||[];
  const meeting=((snap.meetings&&sneak_meetings(snap))||[])[0];
  if(!need.length&&!meeting)return null;
  const tasksAll=(snap.tasks&&snap.tasks.byAssignee)||[];
  const cnt=st=>tasksAll.filter(x=>x.status===st).length;
  const blockers=(snap.board&&snap.board.blockers)||[];
  const employees=(snap.company&&snap.company.employees)||[];
  const rows=need.slice(0,12).map(n=>({main:clip(humanize(n.content),64),sub:n.from?(t('card.from')+(n.from||'')):''}));
  if(meeting){
    rows.push({main:t('card.meeting.dot')+humanize(meeting.type||''),sub:(t('meet.attendees'))+((meeting.attendees||[]).join('、')||t('empty.team'))});
    (meeting.agenda||[]).slice(0,8).forEach((a,i)=>rows.push({main:t('meet.agenda.item').replace('{i}',i+1)+humanize(a)}));
  }
  blockers.slice(0,6).forEach(b=>rows.push({main:'⛔ '+clip(humanize(b.content||''),60),sub:(b.type||'')+(b.id?' · '+b.id:'')}));
  // 各成员任务概览（谁在干什么）
  const byPerson={};
  tasksAll.forEach(x=>{if(['completed','cancelled','dropped'].includes(x.status))return;(byPerson[x.assignee||t('st.unassigned')]=byPerson[x.assignee||t('st.unassigned')]||[]).push(x)});
  Object.entries(byPerson).slice(0,6).forEach(([p,arr])=>rows.push({main:t('meet.person').replace('{p}',p).replace('{k}',arr.length),sub:clip(humanize(arr[0]?arr[0].subject||'':''),52)}));
  const copy=meeting?humanize(meeting.why||meeting.topic||''):(need.length?t('card.waiting.copy'):'');
  return {k:t('card.waiting'),st:t('card.reply'),title:need.length?clip(need[0].content,22):t('card.meeting.req')+(meeting?humanize(meeting.type||''):''),
    copy:clip(copy,200),
    detail:{kicker:t('BOARD · 黑板与会议'),title:meeting?(t('card.meeting.dot')+humanize(meeting.type||'')):t('需要你决定的事项'),
      copy:copy,
      meta:[[t('meet.m.doing'),String(cnt('in_progress'))],[t('meet.m.queued'),String(cnt('pending')+cnt('claimed'))],[t('meet.m.done'),String(cnt('completed'))],[t('meet.m.members'),String(employees.length)]],
      rows:rows,empty:t('empty.decision')}}
}
function sneak_meetings(snap){return (snap.meetings&&snap.meetings.required)||[]}
function cardMission(snap){
  const tasks=(snap.tasks&&snap.tasks.byAssignee)||[];
  const stage=snap.stage||{index:0,total:6,label:'未开始'};
  const doing=tasks.filter(t=>!['completed','cancelled','dropped'].includes(t.status));
  const done=tasks.filter(t=>t.status==='completed');
  const cur=doing.find(t=>t.status==='in_progress')||doing[0];
  if(!cur)return null;
  const pct=tasks.length?Math.round(done.length/tasks.length*100):0;
  return {k:t('card.mission'),st:t('card.running'),title:cur.subject,
    copy:t('card.mission.copy').replace('{a}',cur.assignee||t('st.unassigned')).replace('{s}',STATUS_LABEL(cur.status)).replace('{i}',stage.index).replace('{t2}',stage.total).replace('{l}',stage.label),
    data:pct+'%',dataLabel:t('card.mission.data').replace('{d}',done.length).replace('{n2}',tasks.length),pct,
    detail:{kicker:t('MISSION · 当前任务'),title:cur.subject,
      copy:t('card.mission.detail').replace('{a}',cur.assignee||t('st.unassigned')).replace('{s}',STATUS_LABEL(cur.status)).replace('{att}',cur.attempt>1?t('att.try').replace('{i}',cur.attempt):'').replace('{dep}',cur.dependencies&&cur.dependencies.length?t('att.dep').replace('{d}',cur.dependencies.join('/')):''),
      meta:[[t('m.overall'),pct+'%'],[t('m.doing'),String(doing.length)],[t('m.done'),String(done.length)],[t('m.stage'),`${stage.index}/${stage.total} ${stage.label}`]],
      rows:doing.slice(0,15).map(t=>({main:clip(t.subject,48),sub:`${t.assignee||t('st.unassigned')} · ${STATUS_LABEL(t.status)}`}))}}
}
function cardGap(snap){
  const stage=snap.stage||{};
  if(!(stage.missing&&stage.missing.length))return null;
  return {k:t('card.gap'),st:String(stage.missing.length)+t('card.open'),title:t('card.gap.title').replace('{l}',stage.label||t('stage.cur')),
    copy:humanize(stage.missing.join('；')),
    detail:{kicker:t('STAGE · 阶段推进'),title:t('card.gap.title').replace('{l}',stage.label||t('stage.cur')),
      copy:stage.next?(t('card.gap.next')+humanize(stage.next)):t('card.gap.auto'),
      rows:stage.missing.map(m=>({main:clip(humanize(m),60)})),empty:t('empty.gap')}}
}
function cardQueue(snap){
  const tasks=(snap.tasks&&snap.tasks.byAssignee)||[];
  const doing=tasks.filter(t=>!['completed','cancelled','dropped'].includes(t.status));
  const queued=doing.filter(t=>t.status!=='in_progress');
  if(!queued.length)return null;
  return {k:t('card.queue'),st:queued.length+t('card.pending'),title:queued[0].subject,
    copy:t('card.queue.copy').replace('{a}',queued[0].assignee||t('st.unassigned')).replace('{s}',STATUS_LABEL(queued[0].status)).replace('{more}',queued.length>1?t('card.queue.more').replace('{q}',queued.length):''),
    detail:{kicker:t('QUEUE · 任务队列'),title:t('card.queue.title').replace('{q}',queued.length),
      copy:t('card.queue.desc'),
      rows:queued.slice(0,15).map(t=>({main:clip(t.subject,48),sub:`${t.assignee||t('st.unassigned')} · ${STATUS_LABEL(t.status)}${t.dependencies&&t.dependencies.length?t('att.dep').replace('{d}',t.dependencies.join('/')):''}`}))}}
}
function cardReport(snap){
  const tasks=(snap.tasks&&snap.tasks.byAssignee)||[];
  const done=tasks.filter(t=>t.status==='completed');
  const last=done[done.length-1];
  if(!last)return null;
  return {k:t('card.report'),st:t('card.done'),title:last.subject,
    copy:t('card.report.copy').replace('{a}',last.assignee||t('st.member')).replace('{att}',last.attempt>1?t('card.report.att').replace('{i}',last.attempt):''),
    detail:{kicker:t('REPORT · 完成汇报'),title:t('已完成任务'),
      copy:t('以下任务点已交付，等待验收或已通过。'),
      rows:done.slice(-15).reverse().map(t=>({main:clip(t.subject,48),sub:`${t.assignee||t('st.member')} · ${t('st.completed')}${t.attempt>1?t('st.attN').replace('{n}',t.attempt):''}`}))}}
}
function cardTeam(snap){
  const tasks=(snap.tasks&&snap.tasks.byAssignee)||[];
  const byPerson={};
  for(const t of tasks)(byPerson[t.assignee||t('st.unassigned')]=byPerson[t.assignee||t('st.unassigned')]||[]).push(t);
  const names=Object.keys(byPerson);
  if(names.length<2)return null;
  const busy=names.filter(n=>byPerson[n].some(t=>t.status==='in_progress')).length;
  return {k:t('card.team'),st:names.length+t('card.members'),title:t('团队任务分布'),
    copy:t('card.team.copy').replace('{t}',tasks.length).replace('{b}',busy),
    detail:{kicker:t('TEAM · 团队通道'),title:t('按负责人的任务分布'),
      rows:names.map(n=>{const arr=byPerson[n];const d=arr.filter(t=>t.status==='completed').length;const run=arr.some(t=>t.status==='in_progress');const bad=arr.some(t=>t.status==='failed');
        return {main:t('row.person').replace('{n2}',n).replace('{c}',arr.length).replace('{d}',d),sub:bad?t('row.bad'):run?t('row.run'):t('row.wait')}}) ,empty:t('empty.team')}}
}
function cardEvents(){
  if(!LIVE.events.length)return null;
  return {k:t('card.events'),st:t('card.live'),title:eventLine(LIVE.events[LIVE.events.length-1]),
    copy:t('card.events.copy'),
    detail:{kicker:t('EVENTS · 事件流'),title:t('最近事件'),
      rows:LIVE.events.slice(-15).reverse().map(e=>({main:eventLine(e),sub:eventTime(e)}))}}
}
/* 动态页面：Jarvis 把 HTML 写到 <工作区>/.jarvis/pages/<id>.html，服务端闲置 24h 回收，GC 48h 兜底 */
LIVE.pages=[];
async function loadPages(){
  try{
    const r=await fetch(apiUrl('/api/luke-jarvis/pages'),{cache:'no-store'});
    const b=await r.json();
    const changed=JSON.stringify((b&&b.pages)||[])!==JSON.stringify(LIVE.pages);
    LIVE.pages=(b&&b.pages)||[];
    if(changed&&LIVE.snap)renderMain(LIVE.snap);
  }catch{/* 动态页面失败不影响主状态 */}
}
function cardPages(){
  if(!LIVE.pages.length)return null;
  const latest=LIVE.pages[0];
  const ago=Math.max(1,Math.round((Date.now()-(latest.created||Date.now()))/60000));
  return {k:t('card.pages'),st:LIVE.pages.length+t('card.pages.n'),title:latest.title,
    copy:t('card.pages.copy').replace('{m}',ago),
    detail:{pagesList:true}}
}
function showPageDetail(){
  const body=document.getElementById('detailBody');
  setText('#detailKicker',t('card.pages'));
  setText('#detailTitle',t('pages.title'));
  body.innerHTML=LIVE.pages.length?LIVE.pages.map(p=>{
    const ago=Math.max(1,Math.round((Date.now()-(p.created||Date.now()))/60000));
    return `<div class="detail-row" role="button" tabindex="0" data-page="${esc(p.id)}" data-ptitle="${esc(p.title)}"><div class="detail-row-main">${esc(p.title)}</div><div class="detail-row-sub">${t('pages.row').replace('{m}',ago)}</div></div>`}).join('')
    :`<p class="detail-copy">${esc(t('pages.empty'))}</p>`;
  activateView(detailView,'#detail');
}
function showPageIframe(id,title){
  const body=document.getElementById('detailBody');
  setText('#detailKicker',t('card.pages'));
  setText('#detailTitle',title||id);
  body.innerHTML=`<div class="board-meta" style="padding:8px 12px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center"><span>${esc(t('pages.banner'))}</span><a href="#" id="backToPages" style="color:var(--cyan)">${esc(t('pages.back'))}</a></div><iframe src="/jarvis-wings/dyn/${encodeURIComponent(id)}.html" style="width:100%;height:70vh;border:1px solid rgba(112,234,255,.25);border-radius:8px;background:#020b11"></iframe>`;
  document.getElementById('backToPages').addEventListener('click',e=>{e.preventDefault();showPageDetail()});
  activateView(detailView,'#detail');
}
function renderCards(snap){
  const cards=[cardDecision,cardPages,cardMission,cardGap,cardQueue,cardReport,cardTeam,cardEvents]
    .map(f=>{try{return f(snap)}catch(e){return null}}).filter(Boolean).slice(0,5);
  CARD_SLOTS.forEach((sel,i)=>{
    let el=$(sel);
    if(!el)return;
    // 克隆替换以清除旧演示卡上的点击监听
    const fresh=el.cloneNode(false);
    el.replaceWith(fresh);el=fresh;
    const c=cards[i];
    if(!c){el.style.display='none';return}
    el.style.display='';
    el.dataset.card=String(i);
    el.setAttribute('role','button');el.setAttribute('tabindex','0');
    el.innerHTML=`<div class="node-kicker"><span>${esc(c.k)}</span><span>${esc(c.st||'')}</span></div><div class="node-title">${esc(c.title)}</div><div class="node-copy">${esc(c.copy)}</div>`
      +(c.data?`<div class="node-data"><b>${esc(c.data)}</b><span>${esc(c.dataLabel||'')}</span></div>`:'')
      +(c.pct!=null?`<div class="thin-progress"><i style="width:${c.pct}%"></i></div>`:'')
      +`<span class="node-link">${esc(t('card.detail'))}</span>`;
  });
  LIVE.cards=cards;
}
function showDetail(c){
  if(!c)return;
  if(c.detail&&c.detail.pagesList){showPageDetail();return}
  const body=document.getElementById('detailBody');
  setText('#detailKicker',c.kicker||t('detail.kicker'));
  setText('#detailTitle',c.title||t('detail.title'));
  let html='';
  if(c.copy)html+=`<p class="detail-copy">${esc(c.copy)}</p>`;
  if(c.meta&&c.meta.length)html+=`<div class="report-metrics" style="margin-top:0;margin-bottom:18px">${c.meta.map(([k,v])=>`<div class="report-metric"><span>${esc(k)}</span><b>${esc(v)}</b></div>`).join('')}</div>`;
  if(c.rows)html+=c.rows.length?`<div class="detail-rows">${c.rows.slice(0,20).map(r=>`<div class="detail-row"><div class="detail-row-main">${esc(r.main)}</div>${r.sub?`<div class="detail-row-sub">${esc(r.sub)}</div>`:''}</div>`).join('')}</div>`:`<div class="detail-rows"><div class="board-meta" style="padding:12px">${esc(c.empty||t('empty.generic'))}</div></div>`;
  body.innerHTML=html||`<p class="detail-copy">${esc(t('empty.more'))}</p>`;
  activateView(detailView,'#detail');
}
mainView.addEventListener('click',e=>{
  const node=e.target.closest('.hud-node');
  if(!node||node.id==='voiceNode')return;
  const idx=node.dataset.card;
  const c=(idx!=null&&LIVE.cards)?LIVE.cards[Number(idx)]:null;
  showDetail(c||{kicker:t('detail.demo'),title:($('.node-title',node)||node).textContent?.slice(0,30)||t('detail.title'),
    copy:t('detail.democopy')});
});
mainView.addEventListener('keydown',e=>{
  if(e.key!=='Enter'&&e.key!==' ')return;
  const node=e.target.closest&&e.target.closest('.hud-node[data-card]');
  if(!node||node.id==='voiceNode')return;
  e.preventDefault();
  const c=LIVE.cards?LIVE.cards[Number(node.dataset.card)]:null;
  if(c)showDetail(c);
});
function renderMain(snap){
  const tasks=(snap.tasks&&snap.tasks.byAssignee)||[];
  const stage=snap.stage||{index:0,total:6,label:t('stage.none'),done:[],missing:[],next:''};
  const board=snap.board||{open:[],blockers:[],needsUser:[]};
  const doing=tasks.filter(t=>!['completed','cancelled','dropped'].includes(t.status));
  const done=tasks.filter(t=>t.status==='completed');
  renderCards(snap);
  // 唯一字幕：空闲时显示状态摘要，播报中不覆盖
  const cap=document.getElementById('captionText');
  if(cap&&!speakingNow){
    if(stage.missing&&stage.missing.length)cap.textContent=t('cap.gap.j').replace('{g}',humanize(stage.missing.join('；')));
    else if(stage.index)cap.textContent=t('cap.stage').replace('{l}',stage.label).replace('{d}',(stage.done||[]).length).replace('{t}',stage.total).replace('{k}',doing.length);
    else cap.textContent=t('cap.idle');
  }
  // 顶栏连接状态（诚实标注 demo / 真实工作区）
  const ok=$('.clockbox .ok');
  const bind=document.getElementById('bindInfo');
  if(bind){
    const sid=(window.__activeSessionId||'').replace('session-','').slice(0,8);
    bind.textContent=t('bind.info').replace('{s}',sid||'?').replace('{w}',(snap.workspace&&snap.workspace.cwd)||'?').replace('{t2}',(window.__teamSel||((snap.tasks&&snap.tasks.teams||[]).find(t=>t.active)||{}).name||((snap.tasks&&snap.tasks.teams||[])[0]||{}).name||'?'));
  }
  if(ok)ok.innerHTML=`<i class="pulse-dot"></i>${LIVE.demo?esc(t('bind.demo')):esc(t('bind.live'))+esc(clip((snap.workspace&&snap.workspace.name)||t('bind.ws'),16))+(snap.workspace&&snap.workspace.cwd?' · '+esc(clip(snap.workspace.cwd,28)):'')}`;
  try{
    const ws=(snap.workspace&&(snap.workspace.name||snap.workspace.cwd))||t('bind.ws');
    const lines=[];
    lines.push(t('sp.ws').replace('{w}',ws));
    lines.push(t('sp.stage').replace('{i}',stage.index||0).replace('{t}',stage.total||6).replace('{l}',stage.label||t('stage.na')));
    lines.push(t('sp.tasks').replace('{k}',doing.length).replace('{e}',((snap.company&&snap.company.employees)||[]).length));
    if(board.needsUser&&board.needsUser.length)lines.push(t('sp.board').replace('{k}',board.needsUser.length));
    else if(stage.missing&&stage.missing.length)lines.push(t('sp.gap').replace('{k}',stage.missing.length));
    else if(stage.next)lines.push(t('sp.next').replace('{s}',clip(humanize(String(stage.next)),40)));
    mainSpeech=sanitizeSpeech(lines.join(''));
  }catch(e){}
}

/* 进度页：六阶段能量链 + 真实事件控制台 + 任务完成率 */
function renderProgress(snap){
  const stage=snap.stage||{index:0,total:6,label:t('stage.none'),done:[],missing:[],next:''};
  const tasks=(snap.tasks&&snap.tasks.byAssignee)||[];
  const done=tasks.filter(t=>t.status==='completed');
  const pct=tasks.length?Math.round(done.length/tasks.length*100):0;
  setText('.mission-title h1',(snap.company&&snap.company.company&&snap.company.company.mission)||(snap.workspace&&snap.workspace.name)||t('prog.fallback'));
  setText('.mission-title p',t('prog.sub').replace('{tm}',(snap.tasks&&snap.tasks.teams||[]).map(t=>t.name).join(' / ')||t('empty.team').replace('。','')).replace('{i}',stage.index).replace('{t}',stage.total).replace('{l}',stage.label));
  setText('.room-percent b',pct+'%');
  setText('.room-percent span',t('prog.percent').replace('{d}',done.length).replace('{t}',tasks.length));
  setText('.mission-core-copy h2',t('prog.core').replace('{l}',stage.label));
  setText('.mission-core-copy p',stage.missing&&stage.missing.length?t('cap.gap.j').replace('{g}',humanize(stage.missing.join('；')))+'。'+humanize(stage.next||''):(humanize(stage.next)||t('prog.ready')));
  setText('.chain-title span:last-child',t('prog.steps').replace('{d}',(stage.done||[]).length).replace('{t}',stage.total));
  const chain=$('.chain');
  if(chain){
    const stages=(snap.plugin&&snap.plugin.stages)||[];
    chain.innerHTML=stages.map((s,i)=>{
      const isDone=(stage.done||[]).includes(s.id),isCur=stage.stage===s.id;
      return `<div class="phase ${isDone?'done':isCur?'current':''}"><div class="phase-dot">${String(i+1).padStart(2,'0')}</div><div><div class="phase-name">${esc(s.label)}</div><div class="phase-time">${isDone?t('ph.done'):isCur?t('ph.cur'):t('ph.todo')}</div></div></div>`;
    }).join('')+`<div class="phase-current-desc">${esc(humanize(stage.missing&&stage.missing.length?t('cap.gap.j').replace('{g}',humanize(stage.missing.join('；'))):stage.next||''))}</div>`;
  }
  const consoleEl=$('.console');
  if(consoleEl){
    const rows=LIVE.events.slice(-6).reverse();
    consoleEl.innerHTML=rows.length?rows.map(e=>`<div><span class="time">${eventTime(e)}</span>${esc(eventLine(e))}</div>`).join(''):t('ev.none');
  }
  const metrics=$('.report-metrics');
  if(metrics){
    const board=snap.board||{open:[],blockers:[]};
    const last=done[done.length-1];
    metrics.innerHTML=[[t('m.done2'),`${done.length} / ${tasks.length}`],[t('m.open'),board.open.length],[t('m.block'),board.blockers.length],[t('m.last'),last?clip(last.subject,10):'—']].map(([k,v])=>`<div class="report-metric"><span>${k}</span><b>${esc(v)}</b></div>`).join('');
  }
  setText('.report-say',last_report_text(snap));
}
function last_report_text(snap){
  const last=LIVE.events[LIVE.events.length-1];
  const stage=snap.stage;
  if(last)return `${eventTime(last)} ${humanize(eventLine(last))}。${humanize(stage?stage.next||'':'')}`;
  return t('prog.report.fallback');
}

/* 团队页：成员 = company-state 员工，白板 = 拆分任务点 */
function renderTeam(snap){
  const teams=(snap.tasks&&snap.tasks.teams)||[];
  const activeNames=(snap.tasks&&snap.tasks.activeTeams)||[];
  let picked=null;
  try{picked=teams.find(t=>t.name===window.__teamSel)||null}catch(e){}
  const sid=qsSession||window.__activeSessionId||'';
  picked=picked||teams.find(t=>sid&&String(t.captainSessionId)===sid)||teams.find(t=>t.active)||teams[0]||null;
  const tasks=(picked&&picked.tasks)||[];
  const members=(picked&&picked.members)||[];
  const rows=members.map(m=>{
    const name=m.name||m.role;
    const cur=tasks.find(x=>x.assignee===name&&!['completed','cancelled','failed','dropped'].includes(String(x.status)));
    const done=tasks.filter(x=>x.assignee===name&&['completed','cancelled','failed','dropped'].includes(String(x.status))).length;
    return {name,role:m.role||m.name,model:m.model||'',status:cur?'working':'idle',currentWork:cur?cur.subject:'',taskId:cur?cur.id:'',done};
  });
  const list=$('.member-list');
  if(list){
    list.innerHTML=rows.length?rows.map(m=>{
      const stateLabel={working:t('st.online'),idle:t('st.idle')}[m.status]||m.status;
      const sub=[m.model,t('st.doneN').replace('{n}',m.done)].filter(Boolean).join(' · ');
      return `<div class="member" data-member="${esc(m.name)}" data-role="${esc(m.role)}"><div class="avatar ${m.status==='working'?'':'away'}">${esc(String(m.role||'?').slice(0,1))}</div><div><div class="member-name">${esc(m.name)}</div><div class="member-role">${esc(clip(m.role,12))}${sub?' · '+esc(clip(sub,20)):''}</div></div><div class="member-task">${esc(clip(m.currentWork||'—',10))}<br>${esc(stateLabel)}</div></div>`;
    }).join(''):`<div class="board-meta" style="padding:12px">${esc(t('team.nomembers'))}</div>`;
    setText('.team-panel-head span',t('team.membersN').replace('{m}',String(rows.length).padStart(2,'0')),$('.team-panel')||document);
  }
  const board=$('.board-list');
  if(board){
    board.innerHTML=tasks.length?tasks.slice(0,20).map(t=>{
      const isDone=String(t.status)==='completed';
      const failed=['failed','cancelled','dropped'].includes(String(t.status));
      const p=isDone?100:failed?0:String(t.status)==='in_progress'?50:String(t.status)==='claimed'?20:0;
      return `<div class="board-item ${isDone?'done':''}"><div class="board-top"><span>${esc(clip(t.subject,16))}</span><span>${p}%</span></div><div class="board-meta">${esc(t.assignee||t('st.unassigned'))} · ${esc(STATUS_LABEL(t.status))}${t.attempt?esc(t('st.attN').replace('{n}',t.attempt)):''}</div><div class="board-bar"><i style="width:${p}%"></i></div></div>`;
    }).join(''):`<div class="board-meta" style="padding:12px">${esc(t('team.notasks'))}</div>`;
  }
  const head=$('.team-panel-head');
  if(head&&teams.length>1){
    let sel=document.getElementById('teamPicker');
    if(!sel){sel=document.createElement('select');sel.id='teamPicker';sel.style.cssText='height:24px;margin-left:8px;border:1px solid rgba(112,234,255,.25);background:rgba(5,20,31,.6);color:#9fd9ea;font-size:9px';head.appendChild(sel)}
    sel.innerHTML=teams.map(t=>{const open=(t.tasks||[]).filter(x=>!['completed','cancelled','failed','dropped'].includes(String(x.status))).length;const curSess=sid&&String(t.captainSessionId)===sid;return `<option value="${esc(t.name)}">${esc(t.name)}${t('team.openN').replace('{o}',open)}${curSess?esc(t('team.cursess')):t.active?esc(t('team.cur')):''}</option>`}).join('');
    sel.value=picked?picked.name:'';
    sel.onchange=()=>{window.__teamSel=sel.value;renderTeam(LIVE.snap)};
  }
  const presence=$('.team-presence');
  if(presence){
    const online=rows.filter(e=>e.status==='working').length;
    const doing=tasks.filter(t=>!['completed','cancelled','failed','dropped'].includes(String(t.status))).length;
    presence.innerHTML=`<i class="pulse-dot"></i>${esc(t('team.presence').replace('{o}',online).replace('{k}',doing).replace('{tm}',picked?' · '+t('team.label')+picked.name:''))}`;
  }
  const done=tasks.filter(t=>String(t.status)==='completed');
  const pct=tasks.length?Math.round(done.length/tasks.length*100):0;
  setText('.whiteboard b',pct+'%');
  setText('.whiteboard small',picked?(t('team.label')+picked.name):t('team.board'));
}

function renderAll(){
  if(!LIVE.snap)return;
  try{renderMain(LIVE.snap)}catch(e){console.warn('renderMain',e)}
  try{renderProgress(LIVE.snap)}catch(e){console.warn('renderProgress',e)}
  try{renderTeam(LIVE.snap)}catch(e){console.warn('renderTeam',e)}
}
function sanitizeSpeech(text){
  return String(text||'')
    .replace(/`/g,'')
    .replace(/\*\*/g,'')
    .replace(/https?:\/\/[^\s）)]+/g,t('san.link'))
    .replace(/\.jarvis\/[^\s，。；;）)]*/g,t('san.mem'))
    .replace(/[A-Za-z]:?[\\/][^\s，。；;）)]*/g,t('san.path'))
    .replace(/\bjarvis_[A-Za-z0-9_]+\b/g,'贾维斯工具')
    .replace(/\b[A-Za-z_][A-Za-z0-9_]{2,}\b/g,'')
    .replace(/[（(][^）)]*[）)]/g,'')
    .replace(/[_]+/g,' ')
    .replace(/\s{2,}/g,' ')
    .trim()
}
function parentSessionId(){
  const pat=/(?:session[-/])?([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/i;
  const tryUrls=[];
  try{if(window.parent&&window.parent!==window)tryUrls.push(String(window.parent.location.href))}catch(e){}
  try{if(document.referrer)tryUrls.push(String(document.referrer))}catch(e){}
  for(const u of tryUrls){const m=u.match(pat);if(m)return 'session-'+m[1]}
  return '';
}
const qsSession=(()=>{try{return new URLSearchParams(location.search).get('session')||''}catch(e){return ''}})();
let wsOverride='';
let boundSessionCwd='';
function apiUrl(path){try{const q=new URLSearchParams(location.search);if(wsOverride)q.set('workspace',wsOverride);const qs=q.toString();return path+(qs?(path.includes('?')?'&':'?')+qs:'')}catch(e){return path}}
// 不提供会话/工作区切换下拉：进入时自动锁定「通过哪个会话点进来」的工作区，切换请走 DSH 菜单
async function initWorkspacePicker(){
  try{
    const r=await fetch('/api/jarvis/sessions',{cache:'no-store'});
    const b=await r.json();
    const sessions=(b&&b.sessions)||[];
    const pSid=parentSessionId();
    const active=sessions.find(x=>qsSession&&String(x.id)===qsSession)||sessions.find(x=>pSid&&String(x.id)===pSid)||sessions.find(x=>String(x.status||'')!=='idle'&&String(x.status||'')!=='unknown')||sessions[0];
    if(active)window.__activeSessionId=String(active.id||'');
    try{localStorage.removeItem('jarvis.workspace');localStorage.removeItem('jarvis.workspace.manual')}catch(e){}
    if(active&&active.cwd){wsOverride=String(active.cwd);boundSessionCwd=wsOverride}
    if(wsOverride){try{loadState();loadGreeting()}catch(e){}}
  }catch(e){}
}
initWorkspacePicker();
async function followActiveWorkspace(){
  if(boundSessionCwd)return;
  try{
    const r=await fetch('/api/jarvis/sessions',{cache:'no-store'});const b=await r.json();const sessions=(b&&b.sessions)||[];
    const active=sessions.find(x=>String(x.status)==='running')||sessions.find(x=>String(x.status)!=='idle')||sessions[0];
    if(!active)return;
    window.__activeSessionId=String(active.id||'');
    if(!active.cwd||active.cwd===wsOverride){if(LIVE.snap)renderTeam(LIVE.snap);return}
    wsOverride=String(active.cwd);
    loadState();loadGreeting();
  }catch(e){}
}
setInterval(followActiveWorkspace,10000);


async function loadGreeting(){
  try{
    const r=await fetch(apiUrl('/api/jarvis/greeting'),{cache:'no-store'});
    const b=await r.json();
    if(!b||!b.ok||!b.text)return;
    const clean=sanitizeSpeech(b.text);
    const sentences=splitSentences(clean).slice(0,3);
    const shortText=sentences[0]?sentences[0].slice(0,64):'';
    const cap=document.getElementById('captionText');if(cap&&!speakingNow)cap.textContent=shortText;
    if(sentences.length)mainSpeech=sentences.join('');
    // 播报稿仍以阶段摘要短句为准（loadGreeting 不覆盖 mainSpeech、不自动播报）
  
  }catch(e){/* 问候失败不影响状态 */}
}
async function loadState(){
  try{
    const r=await fetch(apiUrl('/api/jarvis/state'),{cache:'no-store'});
    const body=await r.json();
    if(!body.ok||!body.snapshot)return;
    LIVE.snap=body.snapshot;LIVE.connected=true;LIVE.demo=body.demo===true;
    renderAll();
    loadGreeting();
    loadPages();
  }catch{LIVE.connected=false}
}
async function loadEvents(){
  try{
    const base=apiUrl('/api/jarvis/events');const r=await fetch(base+(base.includes('?')?'&':'?')+`since=${LIVE.lastSeq}&limit=50`,{cache:'no-store'});
    const body=await r.json();
    if(!body.ok||!Array.isArray(body.events))return;
    if(body.events.length){
      LIVE.events.push(...body.events);
      if(LIVE.events.length>200)LIVE.events=LIVE.events.slice(-200);
      LIVE.lastSeq=body.lastSeq||LIVE.lastSeq;
      if(LIVE.snap){renderMain(LIVE.snap);renderProgress(LIVE.snap)}
    }
  }catch{/* 事件失败不影响快照 */}
}
window.__JARVIS_UI__={live:LIVE,reload:loadState,showPage:showPageIframe};
document.getElementById('detailBody').addEventListener('click',e=>{
  const row=e.target.closest&&e.target.closest('[data-page]');
  if(row)showPageIframe(row.dataset.page,row.dataset.ptitle);
});
document.getElementById('detailBody').addEventListener('keydown',e=>{
  if(e.key!=='Enter')return;
  const row=e.target.closest&&e.target.closest('[data-page]');
  if(row)showPageIframe(row.dataset.page,row.dataset.ptitle);
});
loadState();loadEvents();
setInterval(loadState,5000);
setInterval(loadEvents,3000);
})();
