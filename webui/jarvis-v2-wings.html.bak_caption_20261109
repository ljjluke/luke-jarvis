async function startMic(announce=true){if(window.JARVIS_VOICE_ON===false){setMicUI('offline',t('voice.off.hint'));voiceTranscript.textContent=t('voice.off.hint');return}if(!navigator.mediaDevices?.getUserMedia){setMicUI('error',t('mic.err.nosupport'));return}setMicUI('waiting',t('mic.title.waiting'));try{micStream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true}});audioContext=new(window.AudioContext||window.webkitAudioContext)();const source=audioContext.createMediaStreamSource(micStream);analyser=audioContext.createAnalyser();analyser.fftSize=256;analyser.smoothingTimeConstant=.82;source.connect(analyser);micData=new Uint8Array(analyser.fftSize);micActive=true;micMode='wake';setMicUI('wake');voiceTranscript.textContent=t('wake.wait');drawMicWave();startRecognition();selectJarvisVoice();if(announce&&voiceEnabled)speak(t('wake.announce'),true)}catch(error){micActive=false;micMode='off';setMicUI('error',error?.name==='NotAllowedError'?t('mic.err.denied'):t('mic.err.nodev'));voiceTranscript.textContent=t('mic.err.textonly');clearMicWave()}}
function stopMic(announce=true){micActive=false;micMode='off';if(wakeTimer)clearTimeout(wakeTimer);if(recognition){const r=recognition;recognition=null;try{r.stop()}catch{}}if(micStream){micStream.getTracks().forEach(track=>track.stop());micStream=null}if(audioContext){audioContext.close().catch(()=>{});audioContext=null}analyser=null;clearMicWave();setMicUI('offline',t('mic.off.detail'));voiceTranscript.textContent=t('mic.reconnect');if(announce&&voiceEnabled)speak(t('mic.off'),true)}
function toggleMic(){if(micActive)stopMic();else startMic(true)}
voiceNode.addEventListener('click',toggleMic);voiceNode.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();toggleMic()}});clearMicWave();addEventListener('pagehide',()=>{stopMic(false);document.body.classList.remove('jarvis-speaking');if('speechSynthesis'in window)speechSynthesis.cancel()});
// 自动待命：麦克风权限已授权过的浏览器，进页面直接进入唤醒监听，无需手动点「连接麦克风」。
(async function tryAutoWake(){try{await (window.personaReady||Promise.resolve());if(window.JARVIS_VOICE_ON===false)return;if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia)return;if(!navigator.permissions||!navigator.permissions.query)return;const st=await navigator.permissions.query({name:'microphone'}).catch(()=>null);if(!st||st.state!=='granted')return;await new Promise(r=>setTimeout(r,600));if(micActive)return;await startMic(false)}catch(e){}})();
applyPersonaName();
// 首次应用：按缓存的语言/名字刷新静态文案与 JS 文案（persona 返回后再刷新一次）
applyStaticI18n();refreshJSTexts();applyPersonaName();
// 员工协作：本地消息与审批反馈。
const teamChatLog=document.getElementById('teamChatLog'),teamChatInput=document.getElementById('teamChatInput');
function addTeamMessage(author,text){const jn=String(window.JARVIS_NAME||'Jarvis');const item=document.createElement('div');item.className=`chat-message${author===jn?' jarvis':''}`;const head=document.createElement('div');head.className='chat-author';const name=document.createElement('span');name.textContent=author;const time=document.createElement('time');time.textContent=new Date().toLocaleTimeString(window.JARVIS_LANG==='en'?'en-US':'zh-CN',{hour:'2-digit',minute:'2-digit',hour12:false});const body=document.createElement('p');body.textContent=text;head.append(name,time);item.append(head,body);teamChatLog.appendChild(item);teamChatLog.scrollTop=teamChatLog.scrollHeight}
document.getElementById('teamChatForm').addEventListener('submit',e=>{e.preventDefault();const text=teamChatInput.value.trim();if(!text)return;addTeamMessage('你',text);teamChatInput.value='';if(voiceEnabled)speak(t('chat.sent'),true)});
document.querySelectorAll('[data-decision]').forEach(button=>button.addEventListener('click',()=>{const approved=button.dataset.decision==='approve';const result=approved?t('decision.approved'):t('decision.test');const bar=document.getElementById('decisionBar');bar.querySelector('.decision-copy b').textContent=approved?t('decision.ok1'):t('decision.ok2');bar.querySelector('.decision-copy span').textContent=result;bar.querySelector('.decision-actions').textContent=approved?t('decision.approved.short'):t('decision.test.short');addTeamMessage(window.JARVIS_NAME||'Jarvis',result);if(voiceEnabled)speak(result,true)}));
const root=document.documentElement;addEventListener('pointermove',e=>{if(matchMedia('(pointer:fine)').matches){root.style.setProperty('--mx',`${(e.clientX/innerWidth-.5)*18}px`);root.style.setProperty('--my',`${(e.clientY/innerHeight-.5)*12}px`);root.style.setProperty('--ry',`${(e.clientX/innerWidth-.5)*14}deg`);root.style.setProperty('--rx',`${(.5-e.clientY/innerHeight)*10}deg`)}},{passive:true});
const canvas=document.getElementById('particles'),ctx=canvas.getContext('2d');let dots=[],raf=0;function resize(){const dpr=Math.min(devicePixelRatio||1,2);canvas.width=innerWidth*dpr;canvas.height=innerHeight*dpr;canvas.style.width=innerWidth+'px';canvas.style.height=innerHeight+'px';ctx.setTransform(dpr,0,0,dpr,0,0);const count=Math.min(110,Math.floor(innerWidth/14));dots=Array.from({length:count},()=>({x:Math.random()*innerWidth,y:Math.random()*innerHeight,vx:(Math.random()-.5)*.1,vy:(Math.random()-.5)*.1,r:Math.random()*1.1+.2,a:Math.random()*.45+.06}))}function draw(){ctx.clearRect(0,0,innerWidth,innerHeight);for(const p of dots){p.x+=p.vx;p.y+=p.vy;if(p.x<0)p.x=innerWidth;if(p.x>innerWidth)p.x=0;if(p.y<0)p.y=innerHeight;if(p.y>innerHeight)p.y=0;ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fillStyle=`rgba(112,234,255,${p.a})`;ctx.fill()}raf=requestAnimationFrame(draw)}resize();addEventListener('resize',resize);if(!matchMedia('(prefers-reduced-motion: reduce)').matches)draw();else{draw();cancelAnimationFrame(raf)}
if(location.hash==='#progress')showProgress(false,false);else if(location.hash==='#team')showTeam(false);
